    "SOURCE":"@AbapCatalog.sqlViewName: 'ZGET_USERTCODE_V'\r\n@AbapCatalog.compiler.compareFilter: true\r\n@AbapCatalog.preserveKey: true\r\n@AccessControl.authorizationCheck: #NOT_REQUIRED\r\n@EndUserText.label: 'Active tcode for users'\r\n@OData.publish: true //Generates odata service\r\ndefine view  z_c_user_tcodes_cds as select distinct from agr_users as UserRole\r\n    inner join agr_1251 as RoleAuth \r\n      on UserRole.agr_name = RoleAuth.agr_name\r\n{\r\n  key UserRole.uname    as UserId,\r\n  key RoleAuth.low      as TCode\r\n}\r\nwhere \r\n      RoleAuth.object   = 'S_TCODE'\r\n  and RoleAuth.field    = 'TCD'\r\n  and RoleAuth.deleted  = ' '                     // Ignore deleted authorizations\r\n  and UserRole.from_dat <= $session.system_date   // Role assignment must be active today\r\n  and UserRole.to_dat   >= $session.system_date\r\n\r\n    \r\n/*+[internal] {\n\"BASEINFO\":\n{\n\"FROM\":\n[\n\"AGR_1251\",\n\"AGR_USERS\"\n],\n\"ASSOCIATED\":\n[],\n\"BASE\":\n[],\n\"ANNO_REF\":\n[],\n\"SCALAR_FUNCTION\":\n[],\n\"VERSION\":0,\n\"ANNOREF_EVALUATION_ERROR\":\"\"\n}\n}*/",
